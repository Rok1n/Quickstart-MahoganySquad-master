# fnOS host paths: use absolute real paths, not container paths.
DOWNLOAD_HOST_PATH=/vol1/1000/Downloads/Douyin
DATA_HOST_PATH=/vol1/1000/Docker/douyin-nas/data

# Check with: id <your-fnos-user>
PUID=1000
PGID=1000
PORT=18080
TZ=Asia/Shanghai

# Required. Generate with: openssl rand -hex 32
API_KEY=replace-with-a-long-random-key
ALLOW_INSECURE_NO_API_KEY=false

# Recommended. Paste the Cookie request header from a logged-in douyin.com browser session.
DOUYIN_COOKIE=

# Optional proxy. Leave blank if your NAS can reach Douyin directly.
HTTP_PROXY=
HTTPS_PROXY=

DEFAULT_QUALITY=best
DEFAULT_CODEC=auto
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOAD_SIZE_GB=20
MIN_FREE_DISK_GB=20
REQUEST_TIMEOUT_SECONDS=30
DOCS_ENABLED=true

# Pinned upstream parser/signature engine revision.
UPSTREAM_REF=42784ffc83a72a516bfe952153ad7e2a3998d16c
