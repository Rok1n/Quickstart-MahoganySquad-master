# Host port exposed by Docker
PORT=18080
TZ=Asia/Shanghai

# Required in most cases. Paste the Cookie value from a logged-in douyin.com browser request.
DOUYIN_COOKIE=

# Optional but strongly recommended when the parser is reachable from the Internet.
# Leave blank only if the endpoint is LAN-only or protected by another trusted gateway.
COMPAT_TOKEN=

# The parser returns the highest candidate Douyin exposes by default.
DEFAULT_QUALITY=best
DEFAULT_CODEC=auto

# Optional proxy used by the parser when contacting Douyin.
HTTP_PROXY=
HTTPS_PROXY=

# Keep true during setup; set false after deployment if you do not need /docs.
DOCS_ENABLED=true

# Pinned upstream parsing kernel. Change only when intentionally upgrading.
UPSTREAM_REF=42784ffc83a72a516bfe952153ad7e2a3998d16c
